{
  "image": "745540666778.dkr.ecr.eu-west-1.amazonaws.com/nma-batch-processor",
  "vcpus": 1,
  "memory": 2048,
  "command": ["python", "main.py"],
  "jobRoleArn": "arn:aws:iam::745540666778:role/BatchNMAEcsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::745540666778:role/BatchNMAEcsTaskExecutionRole",
  "logConfiguration": {
    "logDriver": "awslogs",
    "options": {
      "awslogs-group": "/aws/batch/job",
      "awslogs-region": "eu-west-1"
    }
  }
}